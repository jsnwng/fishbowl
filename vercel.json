{
  "redirects": [
    { "source": "/fisherman", "destination": "/players/", "permanent": true },
    { "source": "/fisherman/", "destination": "/players/", "permanent": true },
    { "source": "/fisherman/:path+", "destination": "/players/:path+", "permanent": true },
    { "source": "/renderers", "destination": "/renderers/", "permanent": true },
    { "source": "/players", "destination": "/players/", "permanent": true },
    { "source": "/live", "destination": "/live/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
